{
  "version": 1,
  "description": "垃圾清理员永久规则；实际匹配由 RuleChief 执行，清理动作由 GarbageCleaner 执行。",
  "rules": [
    {
      "id": "BOT_TASK",
      "enabled": true,
      "match": {
        "author": {
          "is_bot": true,
          "is_person": false,
          "types": [
            "bot"
          ]
        }
      },
      "action": {
        "type": "DELETE",
        "targets": [
          "config/tasks/{record_id}.json",
          "config/parse_history/{record_id}.json",
          "data/webhook_events/{record_id}.json"
        ]
      }
    },
    {
      "id": "SYSTEM_LEDGER_SUCCESS",
      "enabled": true,
      "match": {
        "assignee": {
          "equals": "system-ledger"
        },
        "task_completed": {
          "in": [
            "SUCCESS",
            "UNCHANGED"
          ]
        }
      },
      "action": {
        "type": "DELETE",
        "targets": [
          "config/tasks/{record_id}.json",
          "config/parse_history/{record_id}.json",
          "data/webhook_events/{record_id}.json",
          "config/任务派发清单/{record_id}.json"
        ]
      }
    },
    {
      "id": "STALE_UNASSIGNED_TASK",
      "enabled": true,
      "match": {
        "assignee": {
          "is_null": true
        },
        "task_completed": {
          "is_null": true
        },
        "created_time": {
          "older_than_minutes": 5
        }
      },
      "action": {
        "type": "DELETE",
        "targets": [
          "config/tasks/{record_id}.json",
          "config/parse_history/{record_id}.json",
          "data/webhook_events/{record_id}.json"
        ]
      }
    },
    {
      "id": "FAILED_TASK",
      "enabled": true,
      "match": {
        "assignee": {
          "not_null": true
        },
        "task_completed": {
          "in": [
            "FAILED",
            "EXECUTE_FAILED"
          ]
        }
      },
      "action": {
        "type": "MOVE",
        "source": "config/tasks/{record_id}.json",
        "target": "config/有问题的任务清单/{record_id}.json"
      }
    }
  ]
}
